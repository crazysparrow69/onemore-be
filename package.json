{
  "name": "onemore-be",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky || true",
    "build": "pnpm -r build",
    "openapi:generate": "pnpm -r openapi:generate",
    "dev": "pnpm --filter core-service dev",
    "dev:nutrition": "pnpm --filter nutrition-service dev",
    "migrate": "pnpm --filter core-service migrate",
    "migrate:nutrition": "pnpm --filter nutrition-service migrate",
    "seed": "pnpm --filter core-service seed",
    "seed:translations": "pnpm --filter core-service seed:translations",
    "media:setup": "pnpm --filter core-service media:setup",
    "popularity:recount": "pnpm --filter core-service popularity:recount",
    "media:cleanup": "pnpm --filter core-service media:cleanup",
    "lint": "pnpm -r lint",
    "format:check": "pnpm -r format:check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -r test:e2e",
    "test:int": "pnpm -r test:int"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  }
}
