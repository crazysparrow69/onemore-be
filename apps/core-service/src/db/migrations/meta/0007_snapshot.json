        },
        "exercises_equipment_check": {
          "name": "exercises_equipment_check",
          "value": "equipment in ('none', 'barbell', 'ez_bar', 'trap_bar', 'dumbbell', 'kettlebell', 'plate', 'machine', 'cable', 'smith_machine', 'suspension', 'band', 'medicine_ball', 'exercise_ball', 'foam_roll', 'other')"
        },
