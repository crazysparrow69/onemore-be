        "exercises_primary_muscles_check": {
          "name": "exercises_primary_muscles_check",
          "value": "cardinality(primary_muscles) >= 1 and primary_muscles <@ array['chest', 'lats', 'upper_back', 'lower_back', 'traps', 'shoulders', 'biceps', 'triceps', 'forearms', 'abdominals', 'quadriceps', 'hamstrings', 'glutes', 'calves', 'adductors', 'abductors', 'neck', 'full_body', 'cardio', 'other']::text[]"
