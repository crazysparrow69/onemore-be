    "/api/exercises": {
      "get": {
        "operationId": "ExercisesController_list",
        "parameters": [
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Search text: every word must match an exercise name or alias, a muscle or equipment label, in any language",
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "name": "muscle",
            "required": false,
            "in": "query",
            "description": "Comma-separated primary muscles; any of them matches",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "equipment",
            "required": false,
            "in": "query",
            "description": "Comma-separated equipment; any of them matches",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mine",
            "required": false,
            "in": "query",
            "description": "true limits the list to exercises created by the caller",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "maximum": 9007199254740991,
              "default": 0,
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 50,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of exercises visible to the caller, named in the caller language",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExerciseListResponse_Output"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "exercises"
        ]
      },
      "post": {
        "operationId": "ExercisesController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExerciseInput"
              }
