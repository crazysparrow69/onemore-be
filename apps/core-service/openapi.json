          "409": {
            "description": "Conflict: the value is already used or a limit is reached (for example NICKNAME_TAKEN, EXERCISE_LIMIT_REACHED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
