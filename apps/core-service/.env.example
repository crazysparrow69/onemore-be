# All variables are required. The service refuses to start if any is missing or invalid.

# development | test | production
NODE_ENV=development

# HTTP port (integer 1-65535). Cloud Run injects PORT.
PORT=8080

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Version reported by GET /health. Cloud Build sets the git SHA in deploys.
APP_VERSION=dev

# Pooled Postgres connection string of the core_svc role (postgresql://...).
# Local: the docker compose db. Prod: Neon pooled string from Secret Manager.
DATABASE_URL=postgresql://core_svc:core_svc_local@localhost:5432/onemore
