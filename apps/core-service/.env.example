# All variables are required. The service refuses to start if any is missing or invalid.

# development | test | production
NODE_ENV=development

# HTTP port (integer 1-65535). Cloud Run injects PORT.
PORT=8080

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Version reported by GET /health. Cloud Build sets the git SHA in deploys.
APP_VERSION=dev
